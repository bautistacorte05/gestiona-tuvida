{
  "expo": {
    "name": "Gestiona tu vida",
    "slug": "gestion-squali-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gestionsqualimobile",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.squali.gestionatuvida",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para dibujar el recorrido del paseo en el mapa.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Usamos tu ubicación para seguir el recorrido del paseo, incluso con la pantalla bloqueada.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.squali.gestionatuvida",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para dibujar el recorrido del paseo en el mapa.",
          "locationAlwaysAndWhenInUsePermission": "Usamos tu ubicación para seguir el recorrido del paseo, incluso con la pantalla bloqueada.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tus fotos para la tarjeta de tu mascota y el cartel de \"se perdió\"."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cada2e9e-9d18-4762-900d-c9370565ec28"
      }
    },
    "owner": "squali",
    "updates": {
      "url": "https://u.expo.dev/cada2e9e-9d18-4762-900d-c9370565ec28"
    }
  }
}
