{
  "expo": {
    "name": "Gestiona tu vida",
    "slug": "gestion-squali-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gestionsqualimobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.squali.gestionatuvida",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para dibujar el recorrido del paseo en el mapa.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Usamos tu ubicación para seguir el recorrido del paseo, incluso con la pantalla bloqueada.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.squali.gestionatuvida",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para dibujar el recorrido del paseo en el mapa.",
          "locationAlwaysAndWhenInUsePermission": "Usamos tu ubicación para seguir el recorrido del paseo, incluso con la pantalla bloqueada.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tus fotos para la tarjeta de tu mascota y el cartel de \"se perdió\"."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
